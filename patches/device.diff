+
 		pcie: pcie@11280000 {
 			compatible = "mediatek,mt7981-pcie",
 				     "mediatek,mt8192-pcie";
@@ -522,6 +539,10 @@ wifi: wifi@18000000 {
 		};
 	};
 
+	rng {
+		compatible = "mediatek,mt7981-rng";
+	};
+
 	timer {
 		compatible = "arm,armv8-timer";
 		interrupt-parent = <&gic>;
